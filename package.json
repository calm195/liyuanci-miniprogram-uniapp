{
  "name": "uniapp-template",
  "version": "1.0.0",
  "private": true,
  "description": "uni-app Vue3 TypeScript 微信小程序模板",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "uni -p mp-weixin",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build": "npm run check && uni build -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "dev:h5": "uni",
    "build:h5": "uni build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030420261029002",
    "@dcloudio/uni-components": "3.0.0-5030420261029002",
    "@dcloudio/uni-h5": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030420261029002",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5",
    "pinia": "2.1.7"
  },
  "devDependencies": {
    "@dcloudio/uni-cli-shared": "3.0.0-5030420261029002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030420261029002",
    "@dcloudio/types": "3.4.31",
    "@types/node": "^22.0.0",
    "vite": "5.2.8",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.1.0",
    "sass": "~1.77.8",
    "tailwindcss": "^4.3.3",
    "weapp-tailwindcss": "^5.0.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.62.0",
    "eslint-plugin-vue": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.8.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@babel/core": "7.29.13",
    "@intlify/core-base@>=9.1.0 <9.1.11": "9.1.11",
    "@intlify/message-resolver@>=9.1.0 <9.1.11": "9.1.11",
    "adm-zip": "0.6.1",
    "body-parser": "1.20.9",
    "express": "4.22.3",
    "follow-redirects": "1.16.2",
    "jpeg-js": "0.4.4",
    "minimatch@>=7.0.0 <11.0.1": "11.0.1",
    "path-to-regexp": "0.1.13",
    "postcss": "8.5.30",
    "postcss-selector-parser@>=6.0.0 <6.1.5": "6.1.5",
    "qs": "6.16.1",
    "source-map-js": "1.2.2",
    "ws": "8.21.0"
  }
}
